# Supabase Auth sign-in and account sync (configure a real project first).
# Publishable key is preferred; the older anon key is supported for existing projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side secrets only; never expose these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
AI_PROVIDER_API_KEY=

# Optional AI cover-letter generation. Disabled unless explicitly enabled.
# Set OPENAI_MODEL to a model identifier supported by your OpenAI project.
# Do not enable on a public deployment until a shared rate limiter is configured.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_COVER_LETTER_ENABLED=false
